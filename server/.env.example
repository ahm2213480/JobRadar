###############################################
# JobRadar API — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is gitignored).
###############################################

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (Neon PostgreSQL) ---
# 1. Create a free project at https://neon.tech
# 2. Copy the pooled connection string and paste it below (uncomment it).
#    Example format:
#    DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL=

# --- Auth (used from Phase 1 onwards — placeholders only for now) ---
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# --- AI provider (used from Phase 3 onwards — placeholders only for now) ---
# The AI layer is pluggable behind IAIService. Fill in the provider you choose.
# AI_PROVIDER=            # openai | anthropic | gemini | openrouter | ollama
# AI_API_KEY=
# AI_MODEL=
