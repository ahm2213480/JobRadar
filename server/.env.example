###############################################
# JobRadar API — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is gitignored).
###############################################

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (Neon PostgreSQL) ---
# 1. Create a free project at https://neon.tech
# 2. Copy the pooled connection string and paste it below (uncomment it).
#    Example format:
#    DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL=

# --- Auth (required from Phase 1) ---
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI provider (Phase 3: CV analysis) ---
# Default provider is Gemini. Get a free API key at https://aistudio.google.com/apikey
# AI_PROVIDER=gemini              # gemini | mock (mock = built-in heuristic extractor, no key needed)
# AI_API_KEY=                     # ← paste your Gemini API key here
# AI_MODEL=gemini-3.6-flash

# --- Job discovery providers (broad inventory incl. LinkedIn data) ---
# All optional: without keys the provider is skipped and other sources sync.
# Keys stay server-side only — never expose them to the browser.
# JSearch (RapidAPI, aggregates LinkedIn + boards):
#   Subscribe (free tier) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=
# Adzuna (official job-search API for gb/us/de/... — no Jordan endpoint):
#   Register at https://developer.adzuna.com/ for app_id + app_key.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- WebSearch (Serper.dev) — "search the web, land on the original site" ---
# Runs user-style queries (title + city/country) through Google's SERP via
# Serper's licensed API and keeps real job-listing URLs (LinkedIn, careers
# pages, boards). 2500 free queries/month, no card — https://serper.dev
# SERPER_API_KEY=
