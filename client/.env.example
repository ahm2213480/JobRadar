# JobRadar web client — environment configuration
# Copy this file to .env and adjust if needed. NEVER put secrets here —
# everything prefixed with VITE_ is embedded into the public browser bundle.

# Base URL of the JobRadar API.
# In development the Vite dev server proxies /api to the backend
# (see vite.config.ts), so the default below works without changes.
VITE_API_BASE_URL=/api
